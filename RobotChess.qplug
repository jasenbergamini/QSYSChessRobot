-- Robot Chess for Q-SYS Designer
-- Tap one of your pieces, then tap the square you want to move it to.
-- Install: copy this file to Documents\QSC\Q-Sys Designer\Plugins, then restart Designer
-- (or right-click the Plugins folder in Schematic Library > Reload Plugins).

PluginInfo = {
  Name = "Games~Robot Chess",
  Version = "1.0",
  BuildVersion = "1.0.0.0",
  Id = "3f9c2a71-8d4e-4b6a-9e1f-5c7d2b8a4e60",
  Description = "Play chess against a robot. Tap a piece, then tap where it should go.",
  ShowDebug = true,
}

function GetColor(props)
  return { 181, 136, 99 }
end

function GetPrettyName(props)
  return "Robot Chess"
end

function GetPages(props)
  return { { name = "Chess" } }
end

function GetModel(props)
  return {}
end

function GetProperties()
  return {
    {
      Name = "Piece Style",
      Type = "enum",
      Choices = { "Symbols", "Letters" },
      Value = "Symbols",
    },
  }
end

function RectifyProperties(props)
  return props
end

function GetPins(props)
  return {}
end

function GetComponents(props)
  return {}
end

function GetWiring(props)
  return {}
end

function GetControls(props)
  local ctrls = {}
  table.insert(ctrls, { Name = "Square", ControlType = "Button", ButtonType = "Toggle", Count = 64, UserPin = false })
  table.insert(ctrls, { Name = "RankLabel", ControlType = "Indicator", IndicatorType = "Text", Count = 8, UserPin = false })
  table.insert(ctrls, { Name = "FileLabel", ControlType = "Indicator", IndicatorType = "Text", Count = 8, UserPin = false })
  table.insert(ctrls, { Name = "Status", ControlType = "Indicator", IndicatorType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "MoveList", ControlType = "Indicator", IndicatorType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "Thinking", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "PlayAs", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "Difficulty", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "PromoteTo", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Both" })
  table.insert(ctrls, { Name = "NewGame", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Input" })
  table.insert(ctrls, { Name = "Undo", ControlType = "Button", ButtonType = "Trigger", Count = 1, UserPin = true, PinStyle = "Input" })
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local letters = props["Piece Style"] ~= nil and props["Piece Style"].Value == "Letters"

  local S = 56                    -- square size
  local X0, Y0 = 40, 44           -- board top-left
  local BOARD = 8 * S
  local PX = X0 + BOARD + 28      -- side panel x
  local PW = 232                  -- side panel width
  local W = PX + PW + 20
  local H = Y0 + BOARD + 40
  local TEXT = { 60, 48, 36 }

  table.insert(graphics, {
    Type = "GroupBox", Text = "Robot Chess", HTextAlign = "Left", FontSize = 14,
    Color = TEXT, Fill = { 238, 233, 224 }, StrokeColor = { 150, 130, 110 },
    StrokeWidth = 1, CornerRadius = 8,
    Position = { 0, 0 }, Size = { W, H },
  })
  table.insert(graphics, {
    Type = "GroupBox", Fill = { 110, 78, 52 }, StrokeWidth = 0, CornerRadius = 3,
    Position = { X0 - 5, Y0 - 5 }, Size = { BOARD + 10, BOARD + 10 },
  })

  -- board squares
  for i = 1, 64 do
    local r, c = (i - 1) // 8, (i - 1) % 8
    local light = ((r + c) % 2 == 0)
    layout["Square " .. i] = {
      PrettyName = "Board~Square " .. i,
      Style = "Button",
      ButtonStyle = "Toggle",
      ButtonVisualStyle = "Flat",
      Legend = "",
      FontSize = letters and 24 or 38,
      Color = light and { 240, 217, 181 } or { 181, 136, 99 },
      CornerRadius = 0,
      StrokeWidth = 0,
      Margin = 0,
      Padding = 0,
      Position = { X0 + c * S, Y0 + r * S },
      Size = { S, S },
    }
  end

  -- rank / file labels (controls so they can flip when you play Black)
  for k = 1, 8 do
    layout["RankLabel " .. k] = {
      PrettyName = "Board~Rank Label " .. k,
      Style = "Text", TextBoxStyle = "NoBackground", IsReadOnly = true,
      HTextAlign = "Center", VTextAlign = "Center", FontSize = 13,
      Position = { X0 - 28, Y0 + (k - 1) * S }, Size = { 18, S },
    }
    layout["FileLabel " .. k] = {
      PrettyName = "Board~File Label " .. k,
      Style = "Text", TextBoxStyle = "NoBackground", IsReadOnly = true,
      HTextAlign = "Center", VTextAlign = "Center", FontSize = 13,
      Position = { X0 + (k - 1) * S, Y0 + BOARD + 8 }, Size = { S, 18 },
    }
  end

  local function label(text, x, y, w)
    table.insert(graphics, {
      Type = "Text", Text = text, Position = { x, y }, Size = { w, 16 },
      FontSize = 12, HTextAlign = "Left", Color = TEXT,
    })
  end

  -- side panel
  layout["Status"] = {
    PrettyName = "Game~Status", Style = "Text", IsReadOnly = true, WordWrap = true,
    HTextAlign = "Center", VTextAlign = "Center", FontSize = 15,
    Position = { PX, Y0 }, Size = { PW, 64 },
  }

  layout["Thinking"] = {
    PrettyName = "Game~Robot Thinking", Style = "Led", Color = { 255, 140, 0 },
    Position = { PX, 120 }, Size = { 16, 16 },
  }
  label("Robot thinking", PX + 24, 120, PW - 24)

  label("Play as", PX, 148, PW)
  layout["PlayAs"] = { PrettyName = "Setup~Play As", Style = "ComboBox", FontSize = 12, Position = { PX, 166 }, Size = { PW, 26 } }

  label("Difficulty", PX, 200, PW)
  layout["Difficulty"] = { PrettyName = "Setup~Difficulty", Style = "ComboBox", FontSize = 12, Position = { PX, 218 }, Size = { PW, 26 } }

  label("Promote pawns to", PX, 252, PW)
  layout["PromoteTo"] = { PrettyName = "Setup~Promote To", Style = "ComboBox", FontSize = 12, Position = { PX, 270 }, Size = { PW, 26 } }

  layout["NewGame"] = {
    PrettyName = "Game~New Game", Style = "Button", ButtonStyle = "Trigger", ButtonVisualStyle = "Flat",
    Legend = "New Game", FontSize = 14, Color = { 140, 210, 140 }, CornerRadius = 4,
    Position = { PX, 308 }, Size = { (PW - 8) // 2, 38 },
  }
  layout["Undo"] = {
    PrettyName = "Game~Undo", Style = "Button", ButtonStyle = "Trigger", ButtonVisualStyle = "Flat",
    Legend = "Undo", FontSize = 14, Color = { 235, 195, 130 }, CornerRadius = 4,
    Position = { PX + (PW - 8) // 2 + 8, 308 }, Size = { (PW - 8) // 2, 38 },
  }

  label("Moves", PX, 356, PW)
  layout["MoveList"] = {
    PrettyName = "Game~Move List", Style = "Text", IsReadOnly = true, WordWrap = true,
    HTextAlign = "Left", VTextAlign = "Top", FontSize = 12,
    Position = { PX, 374 }, Size = { PW, Y0 + BOARD - 374 },
  }

  return layout, graphics
end

--------------------------------------------------------------------------------
-- Runtime
--------------------------------------------------------------------------------
if Controls then
  math.randomseed(os.time())

  -- Board is a 10x12 mailbox: a8 = 21 ... h8 = 28, a1 = 91 ... h1 = 98.
  -- Positive numbers are White, negative are Black, OFF marks the border.
  local OFF = 99
  local WHITE, BLACK = 1, -1
  local PAWN, KNIGHT, BISHOP, ROOK, QUEEN, KING = 1, 2, 3, 4, 5, 6
  local FLAG_EP, FLAG_CASTLE, FLAG_DOUBLE = 1, 2, 3
  local MATE = 100000
  local QDEPTH = 6
  local MOVE_MASK = 0xFFFFF

  local N_OFF = { -21, -19, -12, -8, 8, 12, 19, 21 }
  local B_OFF = { -11, -9, 9, 11 }
  local R_OFF = { -10, -1, 1, 10 }
  local K_OFF = { -11, -10, -9, -1, 1, 9, 10, 11 }
  local VAL = { 100, 320, 330, 500, 900, 0 }
  local FILES = "abcdefgh"

  local SQUARES, IDX, MIR = {}, {}, {}
  for r = 0, 7 do
    for f = 0, 7 do
      local i = r * 8 + f + 1
      local sq = 21 + r * 10 + f
      SQUARES[i] = sq
      IDX[sq] = i
      MIR[i] = (7 - r) * 8 + f + 1
    end
  end

  -- castling rights: 1 = White O-O, 2 = White O-O-O, 4 = Black O-O, 8 = Black O-O-O
  local CMASK = {}
  for i = 0, 119 do CMASK[i] = 15 end
  CMASK[95], CMASK[98], CMASK[91] = 12, 14, 13
  CMASK[25], CMASK[28], CMASK[21] = 3, 11, 7

  -- piece-square tables (White's view, a8 first)
  local PST = {
    { -- pawn
        0,   0,   0,   0,   0,   0,   0,   0,
       50,  50,  50,  50,  50,  50,  50,  50,
       10,  10,  20,  30,  30,  20,  10,  10,
        5,   5,  10,  25,  25,  10,   5,   5,
        0,   0,   0,  20,  20,   0,   0,   0,
        5,  -5, -10,   0,   0, -10,  -5,   5,
        5,  10,  10, -20, -20,  10,  10,   5,
        0,   0,   0,   0,   0,   0,   0,   0 },
    { -- knight
      -50, -40, -30, -30, -30, -30, -40, -50,
      -40, -20,   0,   0,   0,   0, -20, -40,
      -30,   0,  10,  15,  15,  10,   0, -30,
      -30,   5,  15,  20,  20,  15,   5, -30,
      -30,   0,  15,  20,  20,  15,   0, -30,
      -30,   5,  10,  15,  15,  10,   5, -30,
      -40, -20,   0,   5,   5,   0, -20, -40,
      -50, -40, -30, -30, -30, -30, -40, -50 },
    { -- bishop
      -20, -10, -10, -10, -10, -10, -10, -20,
      -10,   0,   0,   0,   0,   0,   0, -10,
      -10,   0,   5,  10,  10,   5,   0, -10,
      -10,   5,   5,  10,  10,   5,   5, -10,
      -10,   0,  10,  10,  10,  10,   0, -10,
      -10,  10,  10,  10,  10,  10,  10, -10,
      -10,   5,   0,   0,   0,   0,   5, -10,
      -20, -10, -10, -10, -10, -10, -10, -20 },
    { -- rook
        0,   0,   0,   0,   0,   0,   0,   0,
        5,  10,  10,  10,  10,  10,  10,   5,
       -5,   0,   0,   0,   0,   0,   0,  -5,
       -5,   0,   0,   0,   0,   0,   0,  -5,
       -5,   0,   0,   0,   0,   0,   0,  -5,
       -5,   0,   0,   0,   0,   0,   0,  -5,
       -5,   0,   0,   0,   0,   0,   0,  -5,
        0,   0,   0,   5,   5,   0,   0,   0 },
    { -- queen
      -20, -10, -10,  -5,  -5, -10, -10, -20,
      -10,   0,   0,   0,   0,   0,   0, -10,
      -10,   0,   5,   5,   5,   5,   0, -10,
       -5,   0,   5,   5,   5,   5,   0,  -5,
        0,   0,   5,   5,   5,   5,   0,  -5,
      -10,   5,   5,   5,   5,   5,   0, -10,
      -10,   0,   5,   0,   0,   0,   0, -10,
      -20, -10, -10,  -5,  -5, -10, -10, -20 },
  }
  local KING_MID = {
    -30, -40, -40, -50, -50, -40, -40, -30,
    -30, -40, -40, -50, -50, -40, -40, -30,
    -30, -40, -40, -50, -50, -40, -40, -30,
    -30, -40, -40, -50, -50, -40, -40, -30,
    -20, -30, -30, -40, -40, -30, -30, -20,
    -10, -20, -20, -20, -20, -20, -20, -10,
     20,  20,   0,   0,   0,   0,  20,  20,
     20,  30,  10,   0,   0,  10,  30,  20 }
  local KING_END = {
    -50, -40, -30, -20, -20, -30, -40, -50,
    -30, -20, -10,   0,   0, -10, -20, -30,
    -30, -10,  20,  30,  30,  20, -10, -30,
    -30, -10,  30,  40,  40,  30, -10, -30,
    -30, -10,  30,  40,  40,  30, -10, -30,
    -30, -10,  20,  30,  30,  20, -10, -30,
    -30, -30,   0,   0,   0,   0, -30, -30,
    -50, -30, -30, -30, -30, -30, -30, -50 }

  ------------------------------------------------------------------------------
  -- Position state + move make/unmake
  ------------------------------------------------------------------------------
  local B = {}
  local side, castle, ep, half = WHITE, 15, 0, 0
  local wK, bK = 95, 25
  local hply = 0
  local uMove, uCap, uCastle, uEp, uHalf = {}, {}, {}, {}, {}

  local function resetBoard()
    for i = 0, 119 do B[i] = OFF end
    local back = { ROOK, KNIGHT, BISHOP, QUEEN, KING, BISHOP, KNIGHT, ROOK }
    for f = 0, 7 do
      B[21 + f] = -back[f + 1]
      B[31 + f] = -PAWN
      for r = 4, 7 do B[r * 10 + 1 + f] = 0 end
      B[81 + f] = PAWN
      B[91 + f] = back[f + 1]
    end
    side, castle, ep, half = WHITE, 15, 0, 0
    wK, bK = 95, 25
    hply = 0
  end

  local function attacked(sq, by)
    if by == WHITE then
      if B[sq + 9] == PAWN or B[sq + 11] == PAWN then return true end
    else
      if B[sq - 9] == -PAWN or B[sq - 11] == -PAWN then return true end
    end
    local n, k = KNIGHT * by, KING * by
    for i = 1, 8 do
      if B[sq + N_OFF[i]] == n or B[sq + K_OFF[i]] == k then return true end
    end
    local b, r, q = BISHOP * by, ROOK * by, QUEEN * by
    for i = 1, 4 do
      local d = B_OFF[i]
      local s = sq + d
      local p = B[s]
      while p == 0 do s = s + d; p = B[s] end
      if p == b or p == q then return true end
      d = R_OFF[i]
      s = sq + d
      p = B[s]
      while p == 0 do s = s + d; p = B[s] end
      if p == r or p == q then return true end
    end
    return false
  end

  local function inCheck(s)
    if s == WHITE then return attacked(wK, BLACK) end
    return attacked(bK, WHITE)
  end

  -- moves are packed ints: from | to<<7 | promo<<14 | flag<<17
  local GL, GN = nil, 0
  local function add(m)
    GN = GN + 1
    GL[GN] = m
  end

  local function addPawn(from, to, promoRow, capsOnly)
    if to // 10 == promoRow then
      add(from | (to << 7) | (QUEEN << 14))
      if not capsOnly then
        add(from | (to << 7) | (ROOK << 14))
        add(from | (to << 7) | (BISHOP << 14))
        add(from | (to << 7) | (KNIGHT << 14))
      end
    else
      add(from | (to << 7))
    end
  end

  local function genMoves(capsOnly)
    GL, GN = {}, 0
    local s = side
    local dir = -10 * s
    local startRow = (s == WHITE) and 8 or 3
    local promoRow = (s == WHITE) and 2 or 9
    for idx = 1, 64 do
      local sq = SQUARES[idx]
      local p = B[sq] * s
      if p > 0 then
        if p == PAWN then
          local t = sq + dir
          if B[t] == 0 then
            if t // 10 == promoRow then
              addPawn(sq, t, promoRow, capsOnly)
            elseif not capsOnly then
              add(sq | (t << 7))
              if sq // 10 == startRow and B[t + dir] == 0 then
                add(sq | ((t + dir) << 7) | (FLAG_DOUBLE << 17))
              end
            end
          end
          local c = t - 1
          local cp = B[c]
          if cp ~= OFF and cp * s < 0 then
            addPawn(sq, c, promoRow, capsOnly)
          elseif c == ep then
            add(sq | (c << 7) | (FLAG_EP << 17))
          end
          c = t + 1
          cp = B[c]
          if cp ~= OFF and cp * s < 0 then
            addPawn(sq, c, promoRow, capsOnly)
          elseif c == ep then
            add(sq | (c << 7) | (FLAG_EP << 17))
          end
        elseif p == KNIGHT or p == KING then
          local offs = (p == KNIGHT) and N_OFF or K_OFF
          for i = 1, 8 do
            local t = sq + offs[i]
            local tp = B[t]
            if tp ~= OFF then
              if tp == 0 then
                if not capsOnly then add(sq | (t << 7)) end
              elseif tp * s < 0 then
                add(sq | (t << 7))
              end
            end
          end
        else
          local offs = (p == BISHOP) and B_OFF or ((p == ROOK) and R_OFF or K_OFF)
          local cnt = (p == QUEEN) and 8 or 4
          for i = 1, cnt do
            local d = offs[i]
            local t = sq + d
            local tp = B[t]
            while tp == 0 do
              if not capsOnly then add(sq | (t << 7)) end
              t = t + d
              tp = B[t]
            end
            if tp ~= OFF and tp * s < 0 then add(sq | (t << 7)) end
          end
        end
      end
    end
    if not capsOnly then
      if s == WHITE then
        if (castle & 1) ~= 0 and B[96] == 0 and B[97] == 0
          and not attacked(95, BLACK) and not attacked(96, BLACK) and not attacked(97, BLACK) then
          add(95 | (97 << 7) | (FLAG_CASTLE << 17))
        end
        if (castle & 2) ~= 0 and B[94] == 0 and B[93] == 0 and B[92] == 0
          and not attacked(95, BLACK) and not attacked(94, BLACK) and not attacked(93, BLACK) then
          add(95 | (93 << 7) | (FLAG_CASTLE << 17))
        end
      else
        if (castle & 4) ~= 0 and B[26] == 0 and B[27] == 0
          and not attacked(25, WHITE) and not attacked(26, WHITE) and not attacked(27, WHITE) then
          add(25 | (27 << 7) | (FLAG_CASTLE << 17))
        end
        if (castle & 8) ~= 0 and B[24] == 0 and B[23] == 0 and B[22] == 0
          and not attacked(25, WHITE) and not attacked(24, WHITE) and not attacked(23, WHITE) then
          add(25 | (23 << 7) | (FLAG_CASTLE << 17))
        end
      end
    end
    return GL
  end

  local function makeMove(m)
    local from, to = m & 127, (m >> 7) & 127
    local promo, flag = (m >> 14) & 7, (m >> 17) & 7
    local piece = B[from]
    hply = hply + 1
    uMove[hply], uCap[hply], uCastle[hply], uEp[hply], uHalf[hply] = m, B[to], castle, ep, half
    B[to], B[from] = piece, 0
    if flag == FLAG_EP then
      B[to + 10 * side] = 0
    elseif flag == FLAG_CASTLE then
      if to == 97 then B[98], B[96] = 0, ROOK
      elseif to == 93 then B[91], B[94] = 0, ROOK
      elseif to == 27 then B[28], B[26] = 0, -ROOK
      else B[21], B[24] = 0, -ROOK end
    end
    if promo ~= 0 then B[to] = promo * side end
    if piece == KING then wK = to elseif piece == -KING then bK = to end
    ep = (flag == FLAG_DOUBLE) and (from - 10 * side) or 0
    castle = castle & CMASK[from] & CMASK[to]
    if piece == PAWN or piece == -PAWN or uCap[hply] ~= 0 then half = 0 else half = half + 1 end
    side = -side
  end

  local function unmakeMove()
    local m = uMove[hply]
    local from, to = m & 127, (m >> 7) & 127
    local promo, flag = (m >> 14) & 7, (m >> 17) & 7
    side = -side
    local piece = (promo ~= 0) and side or B[to]
    B[from], B[to] = piece, uCap[hply]
    if flag == FLAG_EP then
      B[to + 10 * side] = -side
    elseif flag == FLAG_CASTLE then
      if to == 97 then B[96], B[98] = 0, ROOK
      elseif to == 93 then B[94], B[91] = 0, ROOK
      elseif to == 27 then B[26], B[28] = 0, -ROOK
      else B[24], B[21] = 0, -ROOK end
    end
    if piece == KING then wK = from elseif piece == -KING then bK = from end
    castle, ep, half = uCastle[hply], uEp[hply], uHalf[hply]
    hply = hply - 1
  end

  local function legalMoves()
    local list = genMoves(false)
    local out = {}
    for i = 1, #list do
      local m = list[i]
      makeMove(m)
      if not inCheck(-side) then out[#out + 1] = m end
      unmakeMove()
    end
    return out
  end

  local function evaluate()
    local score, npm = 0, 0
    for i = 1, 64 do
      local p = B[SQUARES[i]]
      if p > 0 then
        if p ~= KING then
          score = score + VAL[p] + PST[p][i]
          if p ~= PAWN then npm = npm + VAL[p] end
        end
      elseif p < 0 then
        p = -p
        if p ~= KING then
          score = score - VAL[p] - PST[p][MIR[i]]
          if p ~= PAWN then npm = npm + VAL[p] end
        end
      end
    end
    local kt = (npm <= 2600) and KING_END or KING_MID
    score = score + kt[IDX[wK]] - kt[MIR[IDX[bK]]]
    return score * side
  end

  ------------------------------------------------------------------------------
  -- Search (alpha-beta + quiescence, iterative deepening, time sliced)
  ------------------------------------------------------------------------------
  local clock = os.clock
  pcall(function()
    if type(Timer.Now) == "function" and type(Timer.Now()) == "number" then clock = Timer.Now end
  end)
  -- Q-SYS kills any single script event that runs too long ("Max execution limits
  -- exceeded"), so the search keeps its own stack and can pause at ANY node.
  -- Each timer tick does a few milliseconds of work, then hands control back.
  local SLICE = 0.012
  local nodes, abort, canAbort, deadline = 0, false, false, 0
  local killer1, killer2 = {}, {}

  local function desc(a, b) return a > b end

  local function orderMoves(list, ply, shuffle)
    local k1, k2
    if ply then k1, k2 = killer1[ply], killer2[ply] end
    for i = 1, #list do
      local m = list[i]
      local victim = B[(m >> 7) & 127]
      local key = 0
      if victim ~= 0 then
        local a = B[m & 127]
        key = 100 + (victim > 0 and victim or -victim) * 10 - (a > 0 and a or -a)
      elseif ((m >> 17) & 7) == FLAG_EP then
        key = 109
      elseif m == k1 then
        key = 90
      elseif m == k2 then
        key = 80
      end
      local promo = (m >> 14) & 7
      if promo == QUEEN then key = key + 150 elseif promo ~= 0 then key = key + 5 end
      local r = shuffle and math.random(0, 255) or 0
      list[i] = (key << 28) | (r << 20) | m
    end
    table.sort(list, desc)
    for i = 1, #list do list[i] = list[i] & MOVE_MASK end
  end

  -- search frames (parallel arrays indexed by stack pointer)
  -- kind: 1 = alpha-beta node, 2 = quiescence node
  local FK, FD, FA, FB, FP, FQ, FS = {}, {}, {}, {}, {}, {}, {}
  local FMOV, FI, FLEG, FCHK, FM = {}, {}, {}, {}, {}
  local sp, retVal = 0, nil

  local function push(kind, depth, alpha, beta, ply, qd)
    sp = sp + 1
    FK[sp], FD[sp], FA[sp], FB[sp], FP[sp], FQ[sp], FS[sp] = kind, depth, alpha, beta, ply, qd, 0
  end

  -- Runs the search until it finishes (returns true, score) or the slice runs out
  -- (returns false). All state lives in the frames, so it can resume on the next tick.
  local function run(sliceEnd)
    local count = 0
    while true do
      if retVal ~= nil then
        -- a child just returned
        local v = retVal
        retVal = nil
        if sp == 0 then return true, v end
        local f = sp
        local score = -v
        unmakeMove()
        if score >= FB[f] then
          local m = FM[f]
          if FK[f] == 1 and B[(m >> 7) & 127] == 0 and ((m >> 14) & 7) == 0
            and ((m >> 17) & 7) ~= FLAG_EP then
            local ply = FP[f]
            if killer1[ply] ~= m then
              killer2[ply] = killer1[ply]
              killer1[ply] = m
            end
          end
          sp = f - 1
          retVal = FB[f]
        elseif score > FA[f] then
          FA[f] = score
        end
      else
        local f = sp
        if FS[f] == 0 then
          -- entering a node
          nodes = nodes + 1
          count = count + 1
          if FK[f] == 1 and FD[f] <= 0 then FK[f], FQ[f] = 2, QDEPTH end
          if FK[f] == 2 then
            local checked = inCheck(side)
            FCHK[f] = checked
            local result = nil
            if not checked then
              local stand = evaluate()
              if stand >= FB[f] then
                result = FB[f]
              else
                if stand > FA[f] then FA[f] = stand end
                if FQ[f] <= 0 then result = FA[f] end
              end
            elseif FQ[f] <= 0 then
              result = evaluate()
            end
            if result ~= nil then
              sp = f - 1
              retVal = result
            else
              local mv = genMoves(not checked)
              orderMoves(mv)
              FMOV[f], FI[f], FLEG[f], FS[f] = mv, 0, 0, 1
            end
          else
            local mv = genMoves(false)
            orderMoves(mv, FP[f])
            FMOV[f], FI[f], FLEG[f], FS[f] = mv, 0, 0, 1
          end
          if (count & 7) == 0 then
            local t = clock()
            if canAbort and t > deadline then abort = true return false end
            if t > sliceEnd then return false end
          end
        else
          -- try the next legal move of this node
          local mv = FMOV[f]
          local n = #mv
          local i = FI[f] + 1
          local m
          while i <= n do
            m = mv[i]
            makeMove(m)
            if inCheck(-side) then
              unmakeMove()
              i = i + 1
            else
              break
            end
          end
          FI[f] = i
          if i > n then
            local v
            if FK[f] == 2 then
              v = (FCHK[f] and FLEG[f] == 0) and (-MATE + FP[f]) or FA[f]
            elseif FLEG[f] == 0 then
              v = inCheck(side) and (-MATE + FP[f]) or 0
            elseif half >= 100 then
              v = 0
            else
              v = FA[f]
            end
            sp = f - 1
            retVal = v
          else
            FLEG[f] = FLEG[f] + 1
            FM[f] = m
            if FK[f] == 1 then
              push(1, FD[f] - 1, -FB[f], -FA[f], FP[f] + 1, 0)
            else
              push(2, 0, -FB[f], -FA[f], FP[f] + 1, FQ[f] - 1)
            end
          end
        end
      end
    end
  end

  local LEVELS = {
    Easy   = { depth = 1, time = 1.0, noise = 120 },
    Medium = { depth = 3, time = 2.5, noise = 20 },
    Hard   = { depth = 5, time = 6.0, noise = 0 },
  }

  local function newJob(level)
    nodes, abort, canAbort = 0, false, false
    killer1, killer2 = {}, {}
    sp, retVal = 0, nil
    local moves = legalMoves()
    if #moves > 1 then orderMoves(moves, nil, true) end
    local j = {
      level = level, moves = moves, depth = 1, idx = 1, alpha = -MATE - 1,
      best = nil, bestScore = nil, final = moves[1], start = clock(),
      base = hply, running = false, done = (#moves <= 1),
    }
    deadline = j.start + level.time
    return j
  end

  -- Works on the job for one time slice. Returns true when the robot has decided.
  local function stepJob(j)
    if j.done then return true end
    local lv = j.level
    local sliceEnd = clock() + SLICE
    while true do
      if not j.running then
        makeMove(j.moves[j.idx])
        -- noisy levels need an exact score for every root move, so no root pruning there
        local a = (lv.noise > 0) and (-MATE - 1) or j.alpha
        sp, retVal = 0, nil
        push(1, j.depth - 1, -MATE - 1, -a, 1, 0)
        j.running = true
      end
      local finished, v = run(sliceEnd)
      if abort then
        -- out of time: back out and keep the best move from the last finished depth
        while hply > j.base do unmakeMove() end
        j.done = true
        return true
      end
      if not finished then return false end
      j.running = false
      unmakeMove()
      local m = j.moves[j.idx]
      local score = -v
      if lv.noise > 0 and score > -MATE + 500 and score < MATE - 500 then
        score = score + math.random(-lv.noise, lv.noise)
      end
      if not j.best or score > j.bestScore then j.best, j.bestScore = m, score end
      if score > j.alpha then j.alpha = score end
      j.idx = j.idx + 1
      if j.idx > #j.moves then
        -- finished a full depth
        j.final, canAbort = j.best, true
        for i = 2, #j.moves do
          if j.moves[i] == j.best then
            table.remove(j.moves, i)
            table.insert(j.moves, 1, j.best)
            break
          end
        end
        if j.depth >= lv.depth or j.bestScore >= MATE - 500 or clock() - j.start > lv.time * 0.4 then
          j.done = true
          return true
        end
        j.depth, j.idx, j.alpha, j.best, j.bestScore = j.depth + 1, 1, -MATE - 1, nil, nil
      end
      if clock() > sliceEnd then return false end
    end
  end

  -- blocking version (handy for testing)
  local function think(level)
    local j = newJob(level)
    while not stepJob(j) do end
    return j.final
  end

  ------------------------------------------------------------------------------
  -- Notation
  ------------------------------------------------------------------------------
  local LETTER = { "", "N", "B", "R", "Q", "K" }

  local function sqName(sq)
    local f = sq % 10
    return FILES:sub(f, f) .. (10 - sq // 10)
  end

  local function toSAN(m, legal)
    local from, to = m & 127, (m >> 7) & 127
    local promo, flag = (m >> 14) & 7, (m >> 17) & 7
    local p = B[from]
    local t = p > 0 and p or -p
    local s
    if flag == FLAG_CASTLE then
      s = (to % 10 == 7) and "O-O" or "O-O-O"
    else
      local cap = (B[to] ~= 0) or flag == FLAG_EP
      if t == PAWN then
        s = cap and (FILES:sub(from % 10, from % 10) .. "x") or ""
        s = s .. sqName(to)
        if promo ~= 0 then s = s .. "=" .. LETTER[promo] end
      else
        local ambiguous, sameFile, sameRank = false, false, false
        for k = 1, #legal do
          local o = legal[k]
          local of = o & 127
          if of ~= from and ((o >> 7) & 127) == to and B[of] == p then
            ambiguous = true
            if of % 10 == from % 10 then sameFile = true end
            if of // 10 == from // 10 then sameRank = true end
          end
        end
        s = LETTER[t]
        if ambiguous then
          if not sameFile then s = s .. FILES:sub(from % 10, from % 10)
          elseif not sameRank then s = s .. (10 - from // 10)
          else s = s .. sqName(from) end
        end
        if cap then s = s .. "x" end
        s = s .. sqName(to)
      end
    end
    makeMove(m)
    if inCheck(side) then s = s .. ((#legalMoves() == 0) and "#" or "+") end
    unmakeMove()
    return s
  end

  ------------------------------------------------------------------------------
  -- Game + UI
  ------------------------------------------------------------------------------
  local COLORS = {
    light = "#F0D9B5", dark = "#B58863",
    selL = "#F6EB72", selD = "#DCC34B",
    tgtL = "#C5DFA0", tgtD = "#93B568",
    lastL = "#E3E08A", lastD = "#B9AF4E",
    check = "#E8615A",
  }
  local useLetters = Properties["Piece Style"] ~= nil and Properties["Piece Style"].Value == "Letters"
  local GLYPH_W = useLetters and { "P", "N", "B", "R", "Q", "K" }
    or { "\u{2659}", "\u{2658}", "\u{2657}", "\u{2656}", "\u{2655}", "\u{2654}" }
  local GLYPH_B = useLetters and { "p", "n", "b", "r", "q", "k" }
    or { "\u{265F}", "\u{265E}", "\u{265D}", "\u{265C}", "\u{265B}", "\u{265A}" }
  local PROMO = { Queen = QUEEN, Rook = ROOK, Bishop = BISHOP, Knight = KNIGHT }
  local MIN_THINK = 0.6

  local humanSide = WHITE
  local gamePly = 0
  local legalNow = {}
  local selected, lastFrom, lastTo = nil, nil, nil
  local gameOver, thinking = false, false
  local sanList, keyHist, posCount = {}, {}, {}
  local epoch = 0
  local job = nil
  local thinkTimer = Timer.New()
  local shownLegend, shownColor, shownClass = {}, {}, {}
  -- CSS class for each square color, so a styled UCI can show the real board colors
  local CSS = {
    light = "rc-light", dark = "rc-dark", selL = "rc-sel-light", selD = "rc-sel-dark",
    tgtL = "rc-move-light", tgtD = "rc-move-dark", lastL = "rc-last-light", lastD = "rc-last-dark",
    check = "rc-check",
  }
  local cssOK = pcall(function() Controls.Square[1].CssClass = "rc-sq rc-light" end)

  local function setStatus(s) Controls.Status.String = s end

  local function displayToSq(i)
    local r, c = (i - 1) // 8, (i - 1) % 8
    if humanSide == BLACK then return 98 - r * 10 - c end
    return 21 + r * 10 + c
  end

  local function posKey()
    local t = {}
    for i = 1, 64 do t[i] = B[SQUARES[i]] + 6 end
    return string.char(table.unpack(t)) .. side .. ":" .. castle .. ":" .. ep
  end

  local function insufficient()
    local minors = 0
    for i = 1, 64 do
      local p = B[SQUARES[i]]
      if p ~= 0 then
        local t = p > 0 and p or -p
        if t == PAWN or t == ROOK or t == QUEEN then return false end
        if t == KNIGHT or t == BISHOP then minors = minors + 1 end
      end
    end
    return minors <= 1
  end

  local function render()
    if hply ~= gamePly then return end   -- never draw a half-searched board
    local targets = {}
    if selected then
      for k = 1, #legalNow do
        local m = legalNow[k]
        if (m & 127) == selected then targets[(m >> 7) & 127] = true end
      end
    end
    local checkSq
    if inCheck(side) then checkSq = (side == WHITE) and wK or bK end
    for i = 1, 64 do
      local sq = displayToSq(i)
      local p = B[sq]
      local light = ((sq // 10 + sq % 10) % 2 == 1)
      local key
      if sq == checkSq then key = "check"
      elseif sq == selected then key = light and "selL" or "selD"
      elseif targets[sq] then key = light and "tgtL" or "tgtD"
      elseif sq == lastFrom or sq == lastTo then key = light and "lastL" or "lastD"
      else key = light and "light" or "dark" end
      local color = COLORS[key]
      local legend = ""
      if p > 0 then legend = GLYPH_W[p] elseif p < 0 then legend = GLYPH_B[-p] end
      local ctl = Controls.Square[i]
      if shownLegend[i] ~= legend then ctl.Legend = legend; shownLegend[i] = legend end
      if shownColor[i] ~= color then ctl.Color = color; shownColor[i] = color end
      if cssOK and shownClass[i] ~= key then ctl.CssClass = "rc-sq " .. CSS[key]; shownClass[i] = key end
    end
  end

  local function renderLabels()
    local flip = (humanSide == BLACK)
    for k = 1, 8 do
      Controls.FileLabel[k].String = flip and FILES:sub(9 - k, 9 - k) or FILES:sub(k, k)
      Controls.RankLabel[k].String = tostring(flip and k or (9 - k))
    end
  end

  local function renderMoves()
    local parts = {}
    for i = 1, #sanList, 2 do
      local s = ((i + 1) // 2) .. ". " .. sanList[i]
      if sanList[i + 1] then s = s .. " " .. sanList[i + 1] end
      parts[#parts + 1] = s
    end
    local first = math.max(1, #parts - 29)
    local text = table.concat(parts, "   ", first)
    if first > 1 then text = "... " .. text end
    Controls.MoveList.String = text
  end

  local startRobot, playMove

  local function refreshState(prefix)
    prefix = prefix or ""
    legalNow = legalMoves()
    local checked = inCheck(side)
    local humanTurn = (side == humanSide)
    if #legalNow == 0 then
      gameOver = true
      if not checked then setStatus(prefix .. "Stalemate. It's a draw.")
      elseif humanTurn then setStatus(prefix .. "Checkmate. The robot wins.")
      else setStatus("Checkmate! You beat the robot.") end
    elseif half >= 100 then
      gameOver = true
      setStatus(prefix .. "Draw by the 50-move rule.")
    elseif (posCount[posKey()] or 0) >= 3 then
      gameOver = true
      setStatus(prefix .. "Draw by threefold repetition.")
    elseif insufficient() then
      gameOver = true
      setStatus(prefix .. "Draw. Not enough material left to mate.")
    elseif humanTurn then
      setStatus(prefix .. (checked and "Check! Your move." or "Your move."))
    else
      startRobot()
    end
  end

  function playMove(m, byRobot)
    local san = toSAN(m, legalNow)
    makeMove(m)
    gamePly = hply
    sanList[#sanList + 1] = san
    lastFrom, lastTo = m & 127, (m >> 7) & 127
    selected = nil
    local key = posKey()
    keyHist[#keyHist + 1] = key
    posCount[key] = (posCount[key] or 0) + 1
    refreshState(byRobot and ("Robot played " .. san .. ". ") or nil)
    render()
    renderMoves()
  end

  local function cancelRobot()
    epoch = epoch + 1
    job = nil
    thinkTimer:Stop()
    while hply > gamePly do unmakeMove() end
    thinking = false
    Controls.Thinking.Boolean = false
  end

  -- Rebuild the board from the game's move history (used if the engine ever
  -- gets interrupted mid-move and the position can't be trusted).
  local function resyncBoard()
    local moves = {}
    for k = 1, gamePly do moves[k] = uMove[k] end
    resetBoard()
    for k = 1, #moves do makeMove(moves[k]) end
  end

  local robotErrors = 0

  function startRobot()
    thinking = true
    Controls.Thinking.Boolean = true
    setStatus("Robot is thinking...")
    job = newJob(LEVELS[Controls.Difficulty.String] or LEVELS.Medium)
    thinkTimer:Start(0.005)
  end

  thinkTimer.EventHandler = function()
    local j = job
    if not j then thinkTimer:Stop() return end
    local ok, result = pcall(stepJob, j)
    if ok and not result then return end   -- still thinking, board is mid-search on purpose

    if not ok then
      -- Something interrupted the search. Rebuild the position, shrink the work
      -- per tick, and start this move over (a few tries before giving up).
      print("Robot Chess engine error: " .. tostring(result))
      resyncBoard()
      robotErrors = robotErrors + 1
      SLICE = math.max(0.002, SLICE / 2)
      if robotErrors <= 3 then
        job = newJob(j.level)
        return
      end
    end

    while hply > gamePly do unmakeMove() end
    thinkTimer:Stop()
    job = nil
    local gaveUp = not ok
    robotErrors = 0
    local m = j.final or legalNow[1]
    local myEpoch = epoch
    local function apply()
      if myEpoch ~= epoch then return end
      thinking = false
      Controls.Thinking.Boolean = false
      if m then playMove(m, true) end
      if gaveUp then setStatus(Controls.Status.String .. " (engine errors, see Debug Output)") end
    end
    local wait = MIN_THINK - (clock() - j.start)
    if wait > 0.05 then Timer.CallAfter(apply, wait) else apply() end
  end

  local function undoOne()
    local key = keyHist[#keyHist]
    if key then
      posCount[key] = (posCount[key] or 1) - 1
      keyHist[#keyHist] = nil
    end
    unmakeMove()
    gamePly = hply
    sanList[#sanList] = nil
  end

  local function undo()
    cancelRobot()
    if gamePly > 0 then undoOne() end
    if gamePly > 0 and side ~= humanSide then undoOne() end
    gameOver, selected = false, nil
    if gamePly > 0 then
      local m = uMove[gamePly]
      lastFrom, lastTo = m & 127, (m >> 7) & 127
    else
      lastFrom, lastTo = nil, nil
    end
    refreshState()
    render()
    renderMoves()
  end

  local function newGame()
    cancelRobot()
    resetBoard()
    gamePly = 0
    sanList, keyHist, posCount = {}, {}, {}
    posCount[posKey()] = 1
    selected, lastFrom, lastTo = nil, nil, nil
    gameOver = false
    local pick = Controls.PlayAs.String
    if pick == "Black" then humanSide = BLACK
    elseif pick == "Random" then humanSide = (math.random(2) == 1) and WHITE or BLACK
    else humanSide = WHITE end
    renderLabels()
    refreshState()
    render()
    renderMoves()
  end

  local function onSquare(i)
    if thinking or gameOver or side ~= humanSide or hply ~= gamePly then return end
    local sq = displayToSq(i)
    local p = B[sq]
    if selected and selected ~= sq then
      local want = PROMO[Controls.PromoteTo.String] or QUEEN
      for k = 1, #legalNow do
        local m = legalNow[k]
        if (m & 127) == selected and ((m >> 7) & 127) == sq then
          local pr = (m >> 14) & 7
          if pr == 0 or pr == want then
            playMove(m, false)
            return
          end
        end
      end
    end
    if selected == sq then
      selected = nil
    elseif p * side > 0 then
      selected = sq
    else
      selected = nil
    end
    render()
  end

  -- wire it up
  Controls.PlayAs.Choices = { "White", "Black", "Random" }
  if Controls.PlayAs.String == "" then Controls.PlayAs.String = "White" end
  Controls.Difficulty.Choices = { "Easy", "Medium", "Hard" }
  if not LEVELS[Controls.Difficulty.String] then Controls.Difficulty.String = "Medium" end
  Controls.PromoteTo.Choices = { "Queen", "Rook", "Bishop", "Knight" }
  if not PROMO[Controls.PromoteTo.String] then Controls.PromoteTo.String = "Queen" end

  for i = 1, 64 do
    local ctl = Controls.Square[i]
    ctl.Boolean = true   -- squares stay "on" so they show their true color
    ctl.EventHandler = function(c)
      c.Boolean = true
      onSquare(i)
    end
  end
  Controls.NewGame.EventHandler = function() newGame() end
  Controls.Undo.EventHandler = function() undo() end
  Controls.PlayAs.EventHandler = function() newGame() end

  newGame()
end
